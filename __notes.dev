              <img src="<%= imgSrc %>" alt="<%= p.item %>"
                style="width:50px;height:50px;object-fit:cover;cursor:pointer;"
                data-bs-toggle="modal" data-bs-target="#imgModal"
                data-bs-src="<%= imgSrc %>"
                onclick="document.getElementById('modalImg').src=this.getAttribute('data-bs-src')">
