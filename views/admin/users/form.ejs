<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-person"></i> <%= title %></h4>
  <a href="/admin/users" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <form action="<%= isEdit ? '/admin/users/' + user.user_id + '?_method=PUT' : '/admin/users' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="row g-3">
            <div class="col-6">
              <label class="form-label">First Name <span class="text-danger">*</span></label>
              <input type="text" name="first_name" class="form-control" required value="<%= user ? user.first_name : '' %>">
            </div>
            <div class="col-6">
              <label class="form-label">Last Name <span class="text-danger">*</span></label>
              <input type="text" name="last_name" class="form-control" required value="<%= user ? user.last_name : '' %>">
            </div>
            <div class="col-12">
              <label class="form-label">Email <span class="text-danger">*</span></label>
              <input type="email" name="email" class="form-control" required value="<%= user ? user.email : '' %>">
            </div>
            <% if (!isEdit) { %>
            <div class="col-12">
              <label class="form-label">Password <span class="text-danger">*</span></label>
              <input type="password" name="password" class="form-control" minlength="8" required>
              <div class="form-text">Minimum 8 characters.</div>
            </div>
            <% } %>
            <div class="col-12">
              <label class="form-label">Role <span class="text-danger">*</span></label>
              <select name="role" class="form-select" id="roleSelect" required>
                <% for (const r of ['ADMIN','OFFICE','VIEWER','FACTORY']) { %>
                  <option value="<%= r %>" <%= (user && user.role === r) ? 'selected' : '' %>><%= r %></option>
                <% } %>
              </select>
            </div>
            <div class="col-12" id="factoryField" style="<%= (!user || user.role !== 'FACTORY') ? 'display:none' : '' %>">
              <label class="form-label">Factory (required for FACTORY role)</label>
              <select name="factory_id" class="form-select">
                <option value="">— Select Factory —</option>
                <% for (const f of factories) { %>
                  <option value="<%= f.factory_id %>" <%= (user && user.factory_id == f.factory_id) ? 'selected' : '' %>><%= f.factory_name %></option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save"></i> <%= isEdit ? 'Update User' : 'Create User' %>
            </button>
            <a href="/admin/users" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('roleSelect').addEventListener('change', function() {
    document.getElementById('factoryField').style.display = this.value === 'FACTORY' ? '' : 'none';
  });
</script>
