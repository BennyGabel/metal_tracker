<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-people"></i> User Management</h4>
  <a href="/admin/users/new" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> New User</a>
</div>

<div class="table-responsive">
  <table class="table table-sm table-hover align-middle">
    <thead class="table-dark">
      <tr><th>Name</th><th>Email</th><th>Role</th><th>Factory</th><th>Status</th><th>Last Login</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% if (users.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>
      <% } %>
      <% for (const u of users) { %>
        <tr>
          <td><strong><%= u.first_name %> <%= u.last_name %></strong></td>
          <td><%= u.email %></td>
          <td><span class="badge bg-secondary"><%= u.role %></span></td>
          <td><%= u.factory ? u.factory.factory_name : '—' %></td>
          <td><span class="badge <%= u.is_active ? 'bg-success' : 'bg-danger' %>"><%= u.is_active ? 'Active' : 'Inactive' %></span></td>
          <td class="small text-muted"><%= u.last_login_at ? new Date(u.last_login_at).toLocaleString() : 'Never' %></td>
          <td>
            <a href="/admin/users/<%= u.user_id %>/edit" class="btn btn-sm btn-outline-primary btn-xs">Edit</a>
            <% if (u.is_active) { %>
              <form action="/admin/users/<%= u.user_id %>/deactivate" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-warning btn-xs" onclick="return confirm('Deactivate this user?')">Deactivate</button>
              </form>
            <% } else { %>
              <form action="/admin/users/<%= u.user_id %>/activate" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-success btn-xs">Activate</button>
              </form>
            <% } %>
            <form action="/admin/users/<%= u.user_id %>/reset-password" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline-secondary btn-xs" onclick="return confirm('Reset password?')">Reset Pwd</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
