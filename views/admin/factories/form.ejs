<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-building"></i> <%= title %></h4>
  <a href="/admin/factories" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card">
      <div class="card-body">
        <form action="<%= isEdit ? '/admin/factories/' + factory.factory_id + '?_method=PUT' : '/admin/factories' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Factory Code <span class="text-danger">*</span></label>
              <input type="text" name="factory_code" class="form-control" required maxlength="20"
                value="<%= factory ? factory.factory_code : '' %>" placeholder="e.g. IND-FAC-01">
            </div>
            <div class="col-md-8">
              <label class="form-label">Factory Name <span class="text-danger">*</span></label>
              <input type="text" name="factory_name" class="form-control" required
                value="<%= factory ? factory.factory_name : '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label">Country</label>
              <input type="text" name="country" class="form-control" value="<%= factory ? factory.country : 'India' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label">Contact Name</label>
              <input type="text" name="contact_name" class="form-control" value="<%= factory ? factory.contact_name || '' : '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label">Contact Email</label>
              <input type="email" name="contact_email" class="form-control" value="<%= factory ? factory.contact_email || '' : '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label">Default Return Carrier</label>
              <input type="text" name="default_carrier" class="form-control" value="<%= factory ? factory.default_carrier || '' : 'FedEx' %>">
            </div>
            <div class="col-12">
              <label class="form-label">Address</label>
              <textarea name="address" class="form-control" rows="2"><%= factory ? factory.address || '' : '' %></textarea>
            </div>
            <div class="col-md-8">
              <label class="form-label">Notes</label>
              <input type="text" name="notes" class="form-control" maxlength="50"
                value="<%= factory ? factory.notes || '' : '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label">Terms</label>
              <input type="text" name="terms" class="form-control" maxlength="20"
                value="<%= factory ? factory.terms || '' : '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label">US Abbreviation</label>
              <input type="text" name="us_abbr" class="form-control" maxlength="20"
                value="<%= factory ? factory.us_abbr || '' : '' %>">
            </div>
          </div>

          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-save"></i> <%= isEdit ? 'Update Factory' : 'Create Factory' %>
            </button>
            <a href="/admin/factories" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
