<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-file-earmark-text"></i> Report: Open POs</h4>
  <a href="/reports" class="btn btn-outline-secondary btn-sm">← Reports</a>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2">
      <div class="col-md-3">
        <select name="vendor" class="form-select form-select-sm">
          <option value="">All Vendors</option>
          <% for (const v of vendors) { %><option value="<%= v %>" <%= filters.vendor===v?'selected':'' %>><%= v %></option><% } %>
        </select>
      </div>
      <div class="col-md-2">
        <select name="kt" class="form-select form-select-sm">
          <option value="">All KT</option>
          <% for (const k of kts) { %><option value="<%= k %>" <%= filters.kt===k?'selected':'' %>><%= k %></option><% } %>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="/reports/open-pos" class="btn btn-outline-secondary btn-sm">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="mb-2">
  <a href="/reports/open-pos/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-outline-success btn-sm">
    <i class="bi bi-file-earmark-excel"></i> Excel
  </a>
  <span class="text-muted small ms-2"><%= pos.length %> records</span>
</div>

<div class="table-responsive">
  <table class="table table-sm table-hover">
    <thead class="table-dark">
      <tr><th>PO #</th><th>Vendor</th><th>PO Date</th><th>Item</th><th>KT</th><th class="text-end">Unit FGR</th><th class="text-end">Qty Ord.</th><th class="text-end">Qty Rcvd.</th><th class="text-end">Qty Open</th><th class="text-end">Total Open FGR</th></tr>
    </thead>
    <tbody>
      <% let sumOrd=0,sumRcvd=0,sumOpen=0,sumFgr=0; %>
      <% for (const p of pos) { sumOrd+=p.qty_ordered||0; sumRcvd+=p.qty_received||0; sumOpen+=p.qty_open||0; sumFgr+=parseFloat(p.total_open_fgr||0); %>
        <tr>
          <td><%= p.po_number %></td><td><%= p.vendor %></td><td><%= p.po_date %></td><td><%= p.item %></td>
          <td><span class="badge bg-light text-dark border"><%= p.kt %></span></td>
          <td class="text-end"><%= parseFloat(p.unit_fgr).toFixed(3) %></td>
          <td class="text-end"><%= p.qty_ordered %></td><td class="text-end"><%= p.qty_received %></td>
          <td class="text-end fw-bold"><%= p.qty_open %></td>
          <td class="text-end fw-bold"><%= parseFloat(p.total_open_fgr).toFixed(3) %></td>
        </tr>
      <% } %>
    </tbody>
    <tfoot class="fw-bold table-secondary">
      <tr><td colspan="6">Totals</td><td class="text-end"><%= sumOrd %></td><td class="text-end"><%= sumRcvd %></td><td class="text-end"><%= sumOpen %></td><td class="text-end"><%= sumFgr.toFixed(3) %></td></tr>
    </tfoot>
  </table>
</div>
