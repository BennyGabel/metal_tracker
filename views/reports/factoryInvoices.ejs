<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-box-arrow-down-left"></i> Report: Factory Invoices</h4>
  <a href="/reports" class="btn btn-outline-secondary btn-sm">← Reports</a>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2">
      <% if (currentUser.role !== 'FACTORY') { %>
      <div class="col-md-3">
        <select name="factory_id" class="form-select form-select-sm">
          <option value="">All Factories</option>
          <% for (const f of factories) { %>
            <option value="<%= f.factory_id %>" <%= filters.factory_id == f.factory_id ? 'selected' : '' %>><%= f.factory_name %></option>
          <% } %>
        </select>
      </div>
      <% } %>
      <div class="col-md-2">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <option value="PENDING"  <%= filters.status==='PENDING'?'selected':''  %>>Pending</option>
          <option value="ACCEPTED" <%= filters.status==='ACCEPTED'?'selected':'' %>>Accepted</option>
        </select>
      </div>
      <div class="col-md-2"><input type="date" name="from_date" class="form-control form-control-sm" value="<%= filters.from_date||'' %>"></div>
      <div class="col-md-2"><input type="date" name="to_date" class="form-control form-control-sm" value="<%= filters.to_date||'' %>"></div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="/reports/factory-invoices" class="btn btn-outline-secondary btn-sm">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="mb-2">
  <a href="/reports/factory-invoices/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-outline-success btn-sm">
    <i class="bi bi-file-earmark-excel"></i> Excel
  </a>
  <span class="text-muted small ms-2"><%= invoices.length %> records</span>
</div>

<div class="table-responsive">
  <table class="table table-sm table-hover">
    <thead class="table-dark">
      <tr><th>Invoice #</th><th>Factory</th><th>Invoice Date</th><th class="text-end">Net Grams Rcvd</th><th class="text-end">Value (USD)</th><th>Status</th><th>Received</th></tr>
    </thead>
    <tbody>
      <% let totG=0, totVal=0; %>
      <% for (const inv of invoices) {
           const pg = inv.lines.reduce((a,l)=>a+parseFloat(l.net_weight_g||0),0);
           totG+=pg; totVal+=parseFloat(inv.dollar_value||0);
      %>
        <tr>
          <td><a href="/factory-invoices/<%= inv.invoice_id %>"><%= inv.invoice_number %></a></td>
          <td><%= inv.factory ? inv.factory.factory_name : '—' %></td>
          <td><%= inv.invoice_date %></td>
          <td class="text-end"><%= pg > 0 ? pg.toFixed(3) : '—' %></td>
          <td class="text-end">$<%= parseFloat(inv.dollar_value||0).toFixed(2) %></td>
          <td><%- include('../partials/statusBadge', { status: inv.status }) %></td>
          <td><%= inv.received_date || '—' %></td>
        </tr>
      <% } %>
    </tbody>
    <tfoot class="fw-bold table-secondary">
      <tr><td colspan="3">Totals</td><td class="text-end"><%= totG.toFixed(3) %></td><td class="text-end">$<%= totVal.toFixed(2) %></td><td colspan="2"></td></tr>
    </tfoot>
  </table>
</div>
