<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-journal-bookmark"></i> Report: Balance Statement</h4>
  <a href="/reports" class="btn btn-outline-secondary btn-sm">← Reports</a>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2">
      <div class="col-md-4">
        <select name="factory_id" class="form-select form-select-sm" required>
          <option value="">— Select a Factory —</option>
          <% for (const f of factories) { %>
            <option value="<%= f.factory_id %>" <%= filters.factory_id == f.factory_id ? 'selected' : '' %>><%= f.factory_name %></option>
          <% } %>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">View Statement</button>
      </div>
    </form>
  </div>
</div>

<% if (factory && transactions.length > 0) { %>
<div class="mb-2">
  <a href="/reports/balance-statement/export?factory_id=<%= filters.factory_id %>" class="btn btn-outline-success btn-sm">
    <i class="bi bi-file-earmark-excel"></i> Excel
  </a>
  <span class="text-muted small ms-2"><strong><%= factory.factory_name %></strong> — <%= transactions.length %> transactions</span>
</div>

<div class="table-responsive">
  <table class="table table-sm table-hover">
    <thead class="table-dark">
      <tr><th>Date</th><th>Type</th><th>Purity</th><th class="text-end">Change (g)</th><th class="text-end">Balance After (g)</th><th>Reference</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <% for (const txn of transactions) { %>
        <tr>
          <td class="small"><%= new Date(txn.performed_at).toLocaleString() %></td>
          <td><span class="badge bg-secondary"><%= txn.txn_type %></span></td>
          <td><span class="badge bg-light text-dark border"><%= txn.metal_purity %></span></td>
          <td class="text-end <%= parseFloat(txn.grams_change) >= 0 ? 'text-success' : 'text-danger' %>">
            <%= parseFloat(txn.grams_change) >= 0 ? '+' : '' %><%= parseFloat(txn.grams_change).toFixed(3) %>
          </td>
          <td class="text-end fw-bold"><%= parseFloat(txn.balance_after).toFixed(3) %></td>
          <td class="small"><%= txn.reference_type ? txn.reference_type + ' #' + txn.reference_id : '—' %></td>
          <td class="small"><%= txn.notes || '' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } else if (factory) { %>
  <div class="alert alert-info">No transactions found for <%= factory.factory_name %>.</div>
<% } %>
