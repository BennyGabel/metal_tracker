<h4 class="mb-4"><i class="bi bi-box-arrow-down-left"></i> <%= title %></h4>

<form action="<%= isEdit ? '/factory-invoices/' + invoice.invoice_id + '?_method=PUT' : '/factory-invoices' %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <label class="form-label">Factory <span class="text-danger">*</span></label>
      <select name="factory_id" class="form-select" required <%= isEdit ? 'disabled' : '' %>>
        <option value="">— Select —</option>
        <% for (const f of factories) { %>
          <option value="<%= f.factory_id %>"
            data-carrier="<%= f.default_carrier %>"
            <%= (invoice && invoice.factory_id == f.factory_id) ? 'selected' : '' %>>
            <%= f.factory_name %>
          </option>
        <% } %>
      </select>
      <% if (isEdit) { %>
        <input type="hidden" name="factory_id" value="<%= invoice.factory_id %>">
      <% } %>
    </div>

    <div class="col-md-2">
      <label class="form-label">Invoice Date <span class="text-danger">*</span></label>
      <input type="date" name="invoice_date" class="form-control" required
        value="<%= invoice ? invoice.invoice_date : '' %>">
    </div>

    <div class="col-md-2">
      <label class="form-label">Invoice # <span class="text-danger">*</span></label>
      <input type="text" name="invoice_number" class="form-control" required
        value="<%= invoice ? invoice.invoice_number : '' %>">
    </div>

    <div class="col-md-2">
      <label class="form-label">Carrier</label>
      <input type="text" name="carrier" id="carrierField" class="form-control"
        value="<%= invoice ? invoice.carrier : '' %>" placeholder="Auto-filled from factory">
    </div>

    <div class="col-md-2">
      <label class="form-label">Tracking #</label>
      <input type="text" name="tracking_number" class="form-control"
        value="<%= invoice ? invoice.tracking_number : '' %>">
    </div>

    <div class="col-md-1">
      <label class="form-label">Value (USD)</label>
      <input type="number" name="dollar_value" class="form-control" step="0.01" min="0"
        value="<%= invoice ? parseFloat(invoice.dollar_value).toFixed(2) : '0.00' %>">
    </div>
  </div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">
      <i class="bi bi-save"></i> <%= isEdit ? 'Update Invoice' : 'Create Invoice' %>
    </button>
    <a href="/factory-invoices" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>

<script>
  // Auto-fill carrier from selected factory
  document.querySelector('[name="factory_id"]')?.addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    const carrier = opt.getAttribute('data-carrier');
    if (carrier) document.getElementById('carrierField').value = carrier;
  });
</script>
