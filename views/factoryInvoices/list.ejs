<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-box-arrow-down-left"></i> Factory Invoices (India → NY)</h4>
  <% if (['ADMIN','OFFICE','FACTORY'].includes(currentUser.role)) { %>
  <a href="/factory-invoices/new" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> New Invoice</a>
  <% } %>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2">
      <% if (currentUser.role !== 'FACTORY') { %>
      <div class="col-md-2">
        <select name="factory_id" class="form-select form-select-sm">
          <option value="">All Factories</option>
          <% for (const f of factories) { %>
            <option value="<%= f.factory_id %>" <%= filters.factory_id == f.factory_id ? 'selected' : '' %>><%= f.factory_name %></option>
          <% } %>
        </select>
      </div>
      <% } %>
      <div class="col-md-2">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <option value="PENDING"  <%= filters.status==='PENDING'?'selected':''  %>>Pending</option>
          <option value="ACCEPTED" <%= filters.status==='ACCEPTED'?'selected':'' %>>Accepted</option>
        </select>
      </div>
      <div class="col-md-2">
        <input type="date" name="from_date" class="form-control form-control-sm" value="<%= filters.from_date||'' %>">
      </div>
      <div class="col-md-2">
        <input type="date" name="to_date" class="form-control form-control-sm" value="<%= filters.to_date||'' %>">
      </div>
      <div class="col-md-2">
        <input type="text" name="invoice_number" class="form-control form-control-sm" value="<%= filters.invoice_number||'' %>" placeholder="Invoice #">
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="/factory-invoices" class="btn btn-outline-secondary btn-sm">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="mb-2">
  <a href="/factory-invoices/export/excel" class="btn btn-outline-success btn-sm">
    <i class="bi bi-file-earmark-excel"></i> Excel
  </a>
  <span class="text-muted small ms-2"><%= count %> record(s)</span>
</div>

<div class="table-responsive">
  <table class="table table-hover table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th>Invoice #</th>
        <th>Factory</th>
        <th>Invoice Date</th>
        <th>Carrier</th>
        <th>Tracking</th>
        <th class="text-end">Value (USD)</th>
        <th>Status</th>
        <th>Received</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (invoices.length === 0) { %>
        <tr><td colspan="9" class="text-center text-muted py-4">No invoices found.</td></tr>
      <% } %>
      <% for (const inv of invoices) { %>
        <% const carrier = (inv.factory && inv.factory.default_carrier) || 'FedEx'; %>
        <tr>
          <td><a href="/factory-invoices/<%= inv.invoice_id %>"><%= inv.invoice_number %></a></td>
          <td><%= inv.factory ? inv.factory.factory_name : '—' %></td>
          <td><%= inv.invoice_date %></td>
          <td><%= inv.carrier || '—' %></td>
          <td>
            <% if (inv.tracking_number) { %>
              <a href="https://www.fedex.com/apps/fedextrack/?tracknumbers=<%= inv.tracking_number %>" target="_blank" class="small">
                <%= inv.tracking_number %> <i class="bi bi-box-arrow-up-right"></i>
              </a>
            <% } %>
          </td>
          <td class="text-end">$<%= parseFloat(inv.dollar_value||0).toFixed(2) %></td>
          <td><%- include('../partials/statusBadge', { status: inv.status }) %></td>
          <td><%= inv.received_date || '—' %></td>
          <td><a href="/factory-invoices/<%= inv.invoice_id %>" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
<nav><ul class="pagination pagination-sm">
  <% for (let p = 1; p <= totalPages; p++) { %>
    <li class="page-item <%= p === page ? 'active' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...filters, page: p}).toString() %>"><%= p %></a>
    </li>
  <% } %>
</ul></nav>
<% } %>
