<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h4><i class="bi bi-box-arrow-up-right"></i> <%= shipment.shipment_number %></h4>
    <p class="text-muted mb-0">
      <%- include('../partials/statusBadge', { status: shipment.status }) %>
      &nbsp; <%= shipment.factory ? shipment.factory.factory_name : '—' %> &middot; <%= shipment.shipment_date %>
    </p>
  </div>
  <a href="/casting-shipments" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-8">
    <div class="card h-100">
      <div class="card-header"><strong>Shipment Details</strong></div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">Shipment #</dt><dd class="col-sm-8"><%= shipment.shipment_number %></dd>
          <dt class="col-sm-4">Factory</dt><dd class="col-sm-8"><%= shipment.factory ? shipment.factory.factory_name : '—' %></dd>
          <dt class="col-sm-4">Metal Type</dt><dd class="col-sm-8">
            <span class="badge <%= shipment.metal_type==='GOLD'?'bg-warning text-dark':'bg-secondary' %>"><%= shipment.metal_type %></span>
          </dd>
          <dt class="col-sm-4">Date</dt><dd class="col-sm-8"><%= shipment.shipment_date %></dd>
          <dt class="col-sm-4">Carrier</dt><dd class="col-sm-8"><%= shipment.carrier || 'FedEx' %></dd>
          <dt class="col-sm-4">Tracking #</dt>
          <dd class="col-sm-8">
            <% if (shipment.tracking_number) { %>
              <a href="https://www.fedex.com/apps/fedextrack/?tracknumbers=<%= shipment.tracking_number %>" target="_blank">
                <%= shipment.tracking_number %> <i class="bi bi-box-arrow-up-right"></i>
              </a>
            <% } else { %>—<% } %>
          </dd>
          <dt class="col-sm-4">Total Value</dt><dd class="col-sm-8">$<%= parseFloat(shipment.dollar_value||0).toFixed(2) %></dd>
          <dt class="col-sm-4">Created By</dt><dd class="col-sm-8"><%= shipment.createdBy ? shipment.createdBy.first_name + ' ' + shipment.createdBy.last_name : '—' %></dd>
          <% if (shipment.status === 'REJECTED' && shipment.rejection_notes) { %>
          <dt class="col-sm-4 text-danger">Rejection Notes</dt><dd class="col-sm-8 text-danger"><%= shipment.rejection_notes %></dd>
          <% } %>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header"><strong>Actions</strong></div>
      <div class="card-body d-flex flex-column gap-2">

        <!-- Commercial Invoice (DRAFT, APPROVED, RECEIVED) -->
        <% if (['DRAFT','APPROVED','RECEIVED'].includes(shipment.status)) { %>
          <a href="/casting-shipments/<%= shipment.shipment_id %>/commercial-invoice"
             target="_blank"
             class="btn btn-sm btn-outline-dark">
            <i class="bi bi-file-earmark-text"></i> Print Commercial Invoice
          </a>
        <% } %>

        <!-- DRAFT → Edit / Delete / Submit for Approval -->
        <% if (shipment.status === 'DRAFT' && ['ADMIN','OFFICE'].includes(currentUser.role)) { %>
          <a href="/casting-shipments/<%= shipment.shipment_id %>/edit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit
          </a>
          <form action="/casting-shipments/<%= shipment.shipment_id %>/submit" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-primary w-100" onclick="return confirm('Notify factory for approval?')">
              <i class="bi bi-send"></i> Submit for Approval
            </button>
          </form>
          <% if (currentUser.role === 'ADMIN') { %>
          <form action="/casting-shipments/<%= shipment.shipment_id %>?_method=DELETE" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-outline-danger w-100" onclick="return confirm('Delete this shipment?')">
              <i class="bi bi-trash"></i> Delete
            </button>
          </form>
          <% } %>
        <% } %>

        <!-- Factory: Approve / Reject -->
        <% if (shipment.status === 'DRAFT' && (currentUser.role === 'FACTORY' || currentUser.role === 'ADMIN')) { %>
          <form action="/casting-shipments/<%= shipment.shipment_id %>/approve" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-success w-100" onclick="return confirm('Approve this shipment?')">
              <i class="bi bi-check-circle"></i> Approve
            </button>
          </form>
          <form action="/casting-shipments/<%= shipment.shipment_id %>/reject" method="POST" id="rejectForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-2">
              <textarea name="rejection_notes" class="form-control form-control-sm" rows="2" placeholder="Rejection reason (required)..." required></textarea>
            </div>
            <button class="btn btn-sm btn-danger w-100">
              <i class="bi bi-x-circle"></i> Reject
            </button>
          </form>
        <% } %>

        <!-- APPROVED → Enter Tracking Number -->
        <% if (shipment.status === 'APPROVED' && ['ADMIN','OFFICE'].includes(currentUser.role)) { %>
          <form action="/casting-shipments/<%= shipment.shipment_id %>/ship" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="form-label fw-bold small">Enter Tracking Number</label>
            <input type="text" name="tracking_number" class="form-control form-control-sm mb-2" required placeholder="FedEx tracking #">
            <button class="btn btn-sm btn-warning w-100">
              <i class="bi bi-truck"></i> Save & Mark as Shipped
            </button>
          </form>
        <% } %>

        <!-- SHIPPED → Mark Received (factory or admin) -->
        <% if (shipment.status === 'SHIPPED' && ['FACTORY','ADMIN'].includes(currentUser.role)) { %>
          <form action="/casting-shipments/<%= shipment.shipment_id %>/receive" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-success w-100" onclick="return confirm('Mark as received? This will update metal balances.')">
              <i class="bi bi-check2-all"></i> Mark as Received
            </button>
          </form>
        <% } %>

        <!-- REJECTED → Resubmit -->
        <% if (shipment.status === 'REJECTED' && ['ADMIN','OFFICE'].includes(currentUser.role)) { %>
          <a href="/casting-shipments/<%= shipment.shipment_id %>/edit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit & Resubmit
          </a>
        <% } %>

      </div>
    </div>
  </div>
</div>

<!-- Detail Lines -->
<div class="card">
  <div class="card-header"><strong>Detail Lines</strong></div>
  <div class="card-body p-0">
    <table class="table table-sm mb-0">
      <thead class="table-light">
        <tr>
          <th>Purity</th>
          <th>Pieces</th>
          <th class="text-end">Net Weight (g)</th>
          <th class="text-end">Value (USD)</th>
        </tr>
      </thead>
      <tbody>
        <% let totG = 0, totP = 0; %>
        <% for (const l of shipment.lines) { totG += parseFloat(l.net_weight_g||0); totP += l.pieces||0; %>
          <tr>
            <td><span class="badge bg-light text-dark border"><%= l.metal_purity %></span></td>
            <td><%= l.pieces %></td>
            <td class="text-end"><%= parseFloat(l.net_weight_g).toFixed(3) %></td>
            <td class="text-end">$<%= parseFloat(l.dollar_value||0).toFixed(2) %></td>
          </tr>
        <% } %>
      </tbody>
      <tfoot class="table-light fw-bold">
        <tr>
          <td>Totals</td>
          <td><%= totP %></td>
          <td class="text-end"><%= totG.toFixed(3) %> g</td>
          <td class="text-end">$<%= parseFloat(shipment.dollar_value||0).toFixed(2) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
