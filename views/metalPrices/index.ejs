<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-currency-dollar"></i> Metal Prices</h4>
  <div>
    <% if (['ADMIN','OFFICE'].includes(currentUser.role)) { %>
    <button type="button" class="btn btn-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addPriceModal">
      <i class="bi bi-plus-circle"></i> Add Price
    </button>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importCsvModal">
      <i class="bi bi-filetype-csv"></i> Import CSV
    </button>
    <% } %>
  </div>
</div>

<!-- Filters -->
<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-2">
        <label class="form-label form-label-sm mb-1">From</label>
        <input type="date" name="from" class="form-control form-control-sm" value="<%= filters.from || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label form-label-sm mb-1">To</label>
        <input type="date" name="to" class="form-control form-control-sm" value="<%= filters.to || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label form-label-sm mb-1">Metal</label>
        <select name="metal" class="form-select form-select-sm">
          <option value="">All</option>
          <option value="GOLD" <%= filters.metal === 'GOLD' ? 'selected' : '' %>>GOLD</option>
          <option value="925"  <%= filters.metal === '925'  ? 'selected' : '' %>>925</option>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="/metal-prices" class="btn btn-outline-secondary btn-sm">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- Table -->
<div class="table-responsive">
  <table class="table table-hover table-sm align-middle">
    <thead class="table-dark">
      <tr>
        <th>Date</th>
        <th>Metal</th>
        <th class="text-end">Price</th>
        <th>Last Updated</th>
        <% if (['ADMIN','OFFICE'].includes(currentUser.role)) { %>
        <th></th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% if (prices.length === 0) { %>
        <tr><td colspan="5" class="text-center text-muted py-4">No price records. Add one or import a CSV.</td></tr>
      <% } %>
      <% for (const p of prices) { %>
      <tr>
        <td><%= p.price_date %></td>
        <td><span class="badge bg-secondary"><%= p.metal %></span></td>
        <td class="text-end fw-bold"><%= parseFloat(p.price).toFixed(4) %></td>
        <td class="text-muted small"><%= p.created_at ? new Date(p.created_at).toLocaleString() : '—' %></td>
        <% if (['ADMIN','OFFICE'].includes(currentUser.role)) { %>
        <td class="text-end">
          <button type="button" class="btn btn-sm btn-outline-primary me-1"
            data-bs-toggle="modal" data-bs-target="#editPriceModal"
            data-id="<%= p.price_id %>"
            data-date="<%= p.price_date %>"
            data-metal="<%= p.metal %>"
            data-price="<%= parseFloat(p.price).toFixed(4) %>">
            <i class="bi bi-pencil"></i>
          </button>
          <form action="/metal-prices/<%= p.price_id %>?_method=DELETE" method="POST" class="d-inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline-danger"
              onclick="return confirm('Delete this price entry?')">
              <i class="bi bi-trash"></i>
            </button>
          </form>
        </td>
        <% } %>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Add Price Modal -->
<div class="modal fade" id="addPriceModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-plus-circle"></i> Add Metal Price</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/metal-prices" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Date</label>
            <input type="date" name="price_date" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Metal</label>
            <select name="metal" class="form-select" required>
              <option value="">— select —</option>
              <option value="GOLD">GOLD</option>
              <option value="925">925</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Price</label>
            <input type="number" name="price" class="form-control" step="0.0001" min="0" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Price Modal -->
<div class="modal fade" id="editPriceModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-pencil"></i> Edit Metal Price</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editPriceForm" method="POST">
        <input type="hidden" name="_method" value="PUT">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Date</label>
            <input type="date" id="editPriceDate" name="price_date" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Metal</label>
            <select id="editPriceMetal" name="metal" class="form-select" required>
              <option value="GOLD">GOLD</option>
              <option value="925">925</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Price</label>
            <input type="number" id="editPricePrice" name="price" class="form-control"
              step="0.0001" min="0" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Import CSV Modal -->
<div class="modal fade" id="importCsvModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-filetype-csv"></i> Import Prices from CSV</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/metal-prices/import-csv?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <p class="text-muted small">
            CSV must have a header row with columns: <code>date, metal, price</code>.
            Existing entries for the same date + metal will be updated.
          </p>
          <div class="mb-2">
            <label class="form-label">CSV File</label>
            <input type="file" class="form-control" name="csvFile" accept=".csv,text/csv" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Import</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('editPriceModal').addEventListener('show.bs.modal', function (event) {
  const btn = event.relatedTarget;
  document.getElementById('editPriceForm').action = '/metal-prices/' + btn.dataset.id;
  document.getElementById('editPriceDate').value  = btn.dataset.date;
  document.getElementById('editPriceMetal').value = btn.dataset.metal;
  document.getElementById('editPricePrice').value = btn.dataset.price;
});
</script>
