<h4 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h4>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card border-warning">
      <div class="card-body text-center">
        <div class="fs-2 fw-bold text-warning"><%= openShipments %></div>
        <div class="text-muted small">Open Casting Shipments</div>
        <a href="/casting-shipments?status=DRAFT" class="btn btn-sm btn-outline-warning mt-2">View</a>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-danger">
      <div class="card-body text-center">
        <div class="fs-2 fw-bold text-danger"><%= pendingInvoices %></div>
        <div class="text-muted small">Pending Factory Invoices</div>
        <a href="/factory-invoices?status=PENDING" class="btn btn-sm btn-outline-danger mt-2">View</a>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-info">
      <div class="card-body text-center">
        <div class="fs-2 fw-bold text-info"><%= balancesByFactory.length %></div>
        <div class="text-muted small">Active Factories</div>
        <a href="/metal-balances" class="btn btn-sm btn-outline-info mt-2">Balances</a>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-success">
      <div class="card-body text-center">
        <div class="fs-6 fw-bold text-success">
          <%= lastImport ? lastImport.status : 'N/A' %>
        </div>
        <div class="text-muted small">Last FTP Import</div>
        <div class="small text-muted mt-1"><%= lastImport ? new Date(lastImport.imported_at).toLocaleString() : '—' %></div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Links -->
<% if (currentUser && ['ADMIN','OFFICE'].includes(currentUser.role)) { %>
<div class="mb-4">
  <a href="/casting-shipments/new?type=GOLD" class="btn btn-warning me-2">
    <i class="bi bi-plus-circle"></i> New Gold Shipment
  </a>
  <a href="/casting-shipments/new?type=SILVER" class="btn btn-secondary me-2">
    <i class="bi bi-plus-circle"></i> New Silver Shipment
  </a>
  <a href="/factory-invoices/new" class="btn btn-outline-primary me-2">
    <i class="bi bi-plus-circle"></i> New Factory Invoice
  </a>
</div>
<% } %>

<!-- Metal Prices Widget -->
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong><i class="bi bi-currency-dollar"></i> Current Metal Prices</strong>
    <a href="/metal-prices" class="btn btn-sm btn-outline-primary">
      <% if (currentUser && ['ADMIN','OFFICE'].includes(currentUser.role)) { %>Manage<% } else { %>View All<% } %>
    </a>
  </div>
  <div class="card-body">
    <% if (metalPrices.length === 0) { %>
      <span class="text-muted small">No prices entered yet.
        <% if (currentUser && ['ADMIN','OFFICE'].includes(currentUser.role)) { %>
          <a href="/metal-prices">Add prices</a>
        <% } %>
      </span>
    <% } else { %>
      <div class="d-flex flex-wrap gap-3">
        <% for (const mp of metalPrices) { %>
        <div class="border rounded px-3 py-2 text-center" style="min-width:90px;">
          <div class="text-muted small fw-semibold"><%= mp.metal %></div>
          <div class="fs-6 fw-bold"><%= parseFloat(mp.price).toFixed(4) %></div>
          <div class="text-muted" style="font-size:0.7rem;"><%= mp.price_date %></div>
        </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<!-- Metal Balances Summary -->
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong><i class="bi bi-bar-chart-line"></i> Metal Balances by Factory</strong>
    <a href="/metal-balances" class="btn btn-sm btn-outline-primary">Full Detail</a>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>Factory</th>
            <th class="text-end">10KT (g)</th>
            <th class="text-end">14KT (g)</th>
            <th class="text-end">18KT (g)</th>
            <th class="text-end">925 Silver (g)</th>
          </tr>
        </thead>
        <tbody>
          <% if (balancesByFactory.length === 0) { %>
            <tr><td colspan="5" class="text-center text-muted py-3">No balances yet.</td></tr>
          <% } %>
          <% for (const f of balancesByFactory) { %>
            <tr>
              <td><strong><%= f.factory.factory_name %></strong></td>
              <% for (const p of ['10KT','14KT','18KT','925']) { %>
                <% const g = f.purities[p] || 0; %>
                <td class="text-end <%= g < 0 ? 'text-danger fw-bold' : '' %>">
                  <%= g.toFixed(3) %>
                </td>
              <% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Recent Activity -->
<div class="card">
  <div class="card-header"><strong><i class="bi bi-clock-history"></i> Recent Activity</strong></div>
  <div class="card-body p-0">
    <ul class="list-group list-group-flush">
      <% if (recentActivity.length === 0) { %>
        <li class="list-group-item text-muted">No recent activity.</li>
      <% } %>
      <% for (const log of recentActivity) { %>
        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
          <div>
            <span class="badge bg-secondary me-2"><%= log.action_type %></span>
            <span class="text-muted small"><%= log.entity_type %> #<%= log.entity_id %></span>
            <% if (log.notes) { %><span class="text-muted small ms-2">— <%= log.notes %></span><% } %>
          </div>
          <div class="text-muted small">
            <%= log.user ? log.user.first_name + ' ' + log.user.last_name : 'System' %> &middot;
            <%= new Date(log.created_at).toLocaleString() %>
          </div>
        </li>
      <% } %>
    </ul>
  </div>
</div>
